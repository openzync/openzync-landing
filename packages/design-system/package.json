{
  "name": "@openzync/design-system",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./globals.css": "./src/globals.css",
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "src",
    "src/globals.css",
    "src/tokens.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external react",
    "dev": "tsup src/index.ts --format esm,cjs --dts --external react --watch"
  },
  "peerDependencies": {
    "react": "^19",
    "clsx": "^2",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "tsup": "^8",
    "typescript": "^5"
  }
}
